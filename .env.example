# Pearview environment configuration.
#
# Dev: `source .env` to load these into your shell before `mix phx.server`.
# Deploy: copy to `.env` for local `docker compose up`, or set these as the
# stack environment in Portainer. `.env` is gitignored — never commit secrets.
#
# The `export` prefix is for dev shell sourcing; Docker Compose v2 strips it.

# --- Required secrets -------------------------------------------------------

# OpenRouter API key used for AI categorisation (see Pearview.AI).
export OPENROUTER_API_KEY=sk-or-v1-deadbeef

# Cookie/session signing key (prod only). Generate with: mix phx.gen.secret
export SECRET_KEY_BASE=

# Public hostname the app is served on (prod only; used to build URLs).
export PHX_HOST=pearview.example.com

# --- Optional (sensible defaults shown) -------------------------------------

# Port the app listens on inside the container (and the published host port).
export PORT=4000

# Path to the SQLite database file. In Docker it must sit under the mounted
# volume (/app/data) so it survives container recreation.
export DATABASE_PATH=/app/data/pearview.db

# Database connection pool size.
export POOL_SIZE=5

# Override the OpenRouter model if needed.
export OPENROUTER_MODEL=deepseek/deepseek-v4-flash
