<main class="page">
  <header class="press-masthead">
    <a class="title" href={~p"/"}>pearview</a>
    <nav class="nav">
      <a href={~p"/"}>list</a>
      <a href={~p"/shopper"} aria-current="page">shop</a>
      <a href={~p"/manage"}>manage</a>
    </nav>
  </header>

  <span :if={@categorising?} class="cancel-stamp categorising-note" data-accent="amber">
    Categorising
  </span>

  <div id="shopper-list">
    <.shopper_list groups={@groups} />
  </div>

  <button
    class="stamp-button -accent end-trip-button"
    hx-post={~p"/shopper/trip/end"}
    hx-target="#shopper-list"
    hx-swap="innerHTML"
  >
    Done shopping
  </button>
</main>
