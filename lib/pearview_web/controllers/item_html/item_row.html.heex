<li id={"item-#{@item.id}"} class="item-row">
  <label
    class="item-check"
    hx-patch={~p"/items/#{@item.id}/cycle"}
    hx-target={"#item-#{@item.id}"}
    hx-swap="outerHTML"
  >
    <input
      class="tick-box"
      type="checkbox"
      checked={@item.status == :checked}
      tabindex="-1"
      style="pointer-events:none"
    />
    <span class="_sr-only">Mark {@item.name}</span>
  </label>
  <label class="_sr-only" for={"item_name_#{@item.id}"}>Item name</label>
  <input
    class={["item-name-input", @item.status == :not_available && "-struck"]}
    id={"item_name_#{@item.id}"}
    name="item[name]"
    type="text"
    value={@item.name}
    autocomplete="off"
    required
    hx-patch={~p"/items/#{@item.id}"}
    hx-target={"#item-#{@item.id}"}
    hx-swap="outerHTML"
    hx-trigger="change, keyup[key=='Enter']"
  />
  <button
    type="button"
    class="press-button -ghost -danger -icon"
    aria-label={"Delete #{@item.name}"}
    title="Delete"
    hx-delete={~p"/items/#{@item.id}"}
    hx-target={"#item-#{@item.id}"}
    hx-swap="outerHTML"
  >
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</li>
