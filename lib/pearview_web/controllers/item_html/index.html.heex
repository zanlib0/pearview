<main class="page">
  <header class="press-masthead">
    <a class="title" href={~p"/"}>pearview</a>
    <nav class="nav">
      <a href={~p"/"} aria-current="page">list</a>
    </nav>
  </header>

  <h1 class="t-heading page-heading">Shopping list</h1>

  <form
    class="add-item"
    hx-post={~p"/items"}
    hx-target="#item-list"
    hx-swap="beforeend"
    hx-on::after-request="if (event.detail.successful) this.reset()"
  >
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <div class="form-field add-item-field">
      <label class="label" for="item_name">Add an item</label>
      <input
        class="input"
        id="item_name"
        name="item[name]"
        type="text"
        autocomplete="off"
        required
      />
    </div>
    <button class="stamp-button -accent" type="submit">Add</button>
  </form>

  <ul id="item-list" class="item-list">
    <.item_row :for={item <- @items} item={item} />
  </ul>

  <p class="empty-note t-body">Nothing on the list yet.</p>
</main>
