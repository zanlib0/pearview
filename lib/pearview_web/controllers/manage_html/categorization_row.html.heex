<li id={"categorization-#{@categorization.id}"} class="item-row cache-row">
  <span class="cache-name">{@categorization.normalized_name}</span>
  <%= if @categorization.section do %>
    <span class="cache-placement t-meta">{@categorization.section.name}</span>
  <% else %>
    <span class="cache-placement t-meta -unplaced">Unplaced</span>
  <% end %>
  <button
    type="button"
    class="press-button -ghost -danger -icon"
    aria-label={"Forget where #{@categorization.normalized_name} goes"}
    title="Forget"
    hx-delete={~p"/manage/categorizations/#{@categorization.id}"}
    hx-target={"#categorization-#{@categorization.id}"}
    hx-swap="outerHTML"
    hx-confirm={"Forget where #{@categorization.normalized_name} goes? It is asked again next time it appears; items on the list keep their section."}
  >
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</li>
