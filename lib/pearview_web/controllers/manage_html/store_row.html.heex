<li id={"store-#{@store.id}"} class="item-row store-row">
  <label class="_sr-only" for={"store_name_#{@store.id}"}>Store name</label>
  <input
    class="item-name-input"
    id={"store_name_#{@store.id}"}
    name="store[name]"
    type="text"
    value={@store.name}
    autocomplete="off"
    required
    hx-patch={~p"/manage/stores/#{@store.id}"}
    hx-target={"#store-#{@store.id}"}
    hx-swap="outerHTML"
    hx-trigger="change, keyup[key=='Enter']"
  />
  <button
    type="button"
    class="press-button -ghost -danger -icon"
    aria-label={"Delete #{@store.name}"}
    title="Delete"
    hx-delete={~p"/manage/stores/#{@store.id}"}
    hx-target={"#store-#{@store.id}"}
    hx-swap="outerHTML"
    hx-confirm={"Delete #{@store.name}? Its route and cached categorisations go with it."}
  >
    <svg
      class="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</li>
